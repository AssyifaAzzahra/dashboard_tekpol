generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PKWT
  KARYAWAN
  KASUBAG
  KABAG
  GUEST
}

enum Category {
  HO
  REGIONAL
}

enum RequestType {
  PKWT
  GUEST
}

enum Decision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  role         Role
  isPic        Boolean  @default(false)
  createdAt    DateTime @default(now())

  // relasi
  requests    Request[]  @relation("RequestsByUser") // sebagai requester (user login)
  approvals   Approval[]
  picRequests Request[]  @relation("PicUser") // sebagai PIC
}

model App {
  id          String    @id @default(cuid())
  name        String    @unique
  category    Category
  username    String       // <--- username untuk akses aplikasi
  password    String       // <--- password untuk akses aplikasi
  description String?
  requests    Request[]
}

model Request {
  id   String      @id @default(cuid())
  type RequestType

  // requester (kalau user login)
  requester   User?   @relation("RequestsByUser", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String?

  // aplikasi yang diminta (untuk dropdown nama apps)
  app           App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId         String

  pic           User?      @relation("PicUser", fields: [picId], references: [id])
  picId         String?
  reason        String?
  division      String?
  status        Decision   @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  approvals     Approval[]
  rejectionNote String?

  // GUEST TANPA LOGIN
  guestName    String?      // nama guest yang mengajukan
  trackingCode String? @unique
  trackingPin  String?

  // ⬇⬇⬇ TAMBAHAN OPSIONAL: supaya bisa kirim username/password ke guest via email
  guestEmail   String?      // email guest untuk kirim kredensial
}

model Approval {
  id         String    @id @default(cuid())
  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  approver   User      @relation(fields: [approverId], references: [id], onDelete: Cascade)
  approverId String
  role       Role
  decision   Decision  @default(PENDING)
  note       String?
  decidedAt  DateTime?
}
