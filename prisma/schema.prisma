generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String?    @unique
  sapNo        String?    @unique
  passwordHash String?
  role         Role
  isPic        Boolean    @default(false)
  createdAt    DateTime   @default(now())
  approvals    Approval[]
  newsPosts    News[]     @relation("NewsAuthor")
  picRequests  Request[]  @relation("PicUser")
  requests     Request[]  @relation("RequestsByUser")
  pksDocuments PksDocumentSubmission[]
  pksCode String? @unique

}

model App {
  id          String    @id @default(cuid())

  name        String    @unique
  category    Category

  url         String?
  description String?
  logoUrl     String?

  // 🔐 Credentials (opsional)
  username    String?
  password    String?

  // relasi
  requests    Request[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category, name])
}

model Request {
  id            String      @id @default(cuid())
  type          RequestType
  requesterId   String?
  appId         String
  picId         String?
  reason        String?
  division      String?
  status        Decision    @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rejectionNote String?
  guestName     String?
  trackingCode  String?     @unique
  trackingPin   String?
  guestEmail    String?
  approvals     Approval[]
  app           App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  pic           User?       @relation("PicUser", fields: [picId], references: [id])
  requester     User?       @relation("RequestsByUser", fields: [requesterId], references: [id], onDelete: Cascade)
}

model Approval {
  id         String    @id @default(cuid())
  requestId  String
  approverId String
  role       Role
  decision   Decision  @default(PENDING)
  note       String?
  decidedAt  DateTime?
  approver   User      @relation(fields: [approverId], references: [id], onDelete: Cascade)
  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  actorId    String?
  actorEmail String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum NewsSource {
  INTERNAL
  INSTAGRAM
}


model News {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  isPublished   Boolean    @default(false)
  publishedAt   DateTime?
  authorId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  author        User?      @relation("NewsAuthor", fields: [authorId], references: [id])

  // ✅ NEW
  sourceType    NewsSource @default(INTERNAL)
  instagramUrl  String?

  @@index([isPublished, publishedAt])
  @@index([sourceType])
}


model GalleryCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model Gallery {
  id        String   @id @default(cuid())
  title     String?
  caption   String?
  category  String?
  imageUrl  String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, order])
  @@index([category])
}

model Pks {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  shortProfile     String?
  address          String?
  capacity         String?
  yearOperation    Int?
  lineCount        Int?
  operationalNotes String?
  photoUrl         String?
  structureUrl     String?
  certificateUrl   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Ppis {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortProfile     String?
  address          String?
  capacity         String?
  yearOperation    Int?
  lineCount        Int?
  operationalNotes String?
  photoUrl         String?
  structureUrl     String?
  certificateUrl   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Ppkr {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortProfile     String?
  address          String?
  capacity         String?
  yearOperation    Int?
  lineCount        Int?
  operationalNotes String?
  photoUrl         String?
  structureUrl     String?
  certificateUrl   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PksProfileDeck {
  id        String   @id @default(cuid())
  pksId     String   @unique
  fileUrl   String
  fileName  String
  fileType  String        // wajib
  coverUrl  String?       // optional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PksDocumentSubmission {
  id           String   @id @default(cuid())
  pksCode      String
  pksName      String?

  fileUrl      String
  originalName String
  mimeType     String?
  sizeBytes    Int

  status    DocStatus @default(PENDING)
  adminNote String?

  uploader   User?   @relation(fields: [uploaderId], references: [id])
  uploaderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  PKWT
  KARYAWAN
  KASUBAG
  KABAG
  GUEST
  SUPERADMIN
  ADMIN
}

enum Category {
  HO
  REGIONAL
}

enum RequestType {
  PKWT
  GUEST
}

enum Decision {
  PENDING
  APPROVED
  REJECTED
}
enum DocStatus {
  PENDING
  ACCEPTED
  REJECTED
}

